{
  "version": 1,
  "grades": {
    "confirmed": "The detector is almost never wrong about what it found. Blocks COMPLETE when the fix type is designated and no justified disposition exists.",
    "heuristic": "May or may not be slop. Needs a reviewer verdict; the verdict content does not block."
  },
  "disposition_exceptions": {
    "lint-suppression": [
      "allowed_suppression",
      "external_constraint"
    ],
    "swallowed-error": [
      "external_constraint"
    ],
    "commented-code": [],
    "banner-comment": [],
    "hash-integrity": [
      "last_resort",
      "external_constraint",
      "not_integrity"
    ]
  },
  "rules": [
    {
      "id": "RS-LINT-SUPPRESSION",
      "languages": [
        "rust"
      ],
      "grade": "confirmed",
      "fix_type": "lint-suppression",
      "where": "code",
      "pattern": "#\\s*!?\\s*\\[\\s*(allow|expect)\\s*\\(|#\\s*!?\\s*\\[\\s*cfg_attr\\s*\\(.*\\b(allow|expect)\\s*\\(",
      "manual_ref": "2.3 억제 주석 복사; 5.4; 5.6 린트·타입 억제",
      "positive": [
        {
          "lang": "rust",
          "code": "#[allow(dead_code)]\nfn unused() {}\n",
          "count": 1
        },
        {
          "lang": "rust",
          "code": "#![allow(clippy::all)]\n",
          "count": 1
        },
        {
          "lang": "rust",
          "code": "#[cfg_attr(test, allow(unused))]\nfn f() {}\n",
          "count": 1
        },
        {
          "lang": "rust",
          "code": "#[expect(unused_variables)]\nlet x = 1;\n",
          "count": 1
        },
        {
          "lang": "rust",
          "code": "# [allow(dead_code)]\nfn f() {}\n",
          "count": 1
        }
      ],
      "negative": [
        {
          "lang": "rust",
          "code": "let s = \"#[allow(dead_code)]\";\n"
        },
        {
          "lang": "rust",
          "code": "// #[allow(dead_code)] is discussed here\nfn f() {}\n"
        },
        {
          "lang": "rust",
          "code": "#[deny(warnings)]\nfn f() {}\n"
        }
      ]
    },
    {
      "id": "PY-LINT-SUPPRESSION",
