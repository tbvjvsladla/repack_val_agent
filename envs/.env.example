ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# skillevaluator LLM stages (export into the shell before running the CLI)
SKILL_EVAL_LLM_PROVIDER=
NVIDIA_API_KEY=
