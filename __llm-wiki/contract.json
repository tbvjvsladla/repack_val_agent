{
  "schema_version": 1,
  "project_name": "val_agent",
  "wiki_dir": "__llm-wiki",
  "source_roots": [
    "docs"
  ],
  "excluded_roots": [],
  "source_suffixes": [
    ".md"
  ],
  "authority_rules": [
    {
      "pattern": "docs/interview/**",
      "document_type": "interview",
      "authority_rank": 0,
      "role": "intent-and-agreement"
    },
    {
      "pattern": "docs/plan/**",
      "document_type": "plan",
      "authority_rank": 0,
      "role": "implementation-plan"
    },
    {
      "pattern": "docs/devlog/**",
      "document_type": "devlog",
      "authority_rank": 0,
      "role": "execution-record"
    },
    {
      "pattern": "docs/checklist/**",
      "document_type": "checklist",
      "authority_rank": 0,
      "role": "verification-record"
    }
  ],
  "fallback": {
    "document_type": "reference",
    "authority_rank": 0,
    "role": "reference"
  },
  "copy_policy": "path_reference",
  "frontmatter_aliases": {
    "task_id": [],
    "created": [],
    "updated": [],
    "status": [],
    "related_interview": [],
    "related_plan": [],
    "related_devlog": [],
    "related_checklist": [],
    "document_type": []
  },
  "filename_pattern": "^(?<prefix>)(?<yymmddhh>\\d{8})(?:_[0-5]\\d_[0-5]\\d)?_(?<title>(?!\\d{2}_\\d{2}_)(?=[^/]*[가-힣])[가-힣A-Za-z0-9_]+)\\.md$",
  "layout": {
    "cards_dir": "cards",
    "cache_dir": ".cache",
    "archive_dir": "archive"
  },
  "search": {
    "bm25_k1": 1.2,
    "bm25_b": 0.75,
    "field_boost": {
      "title": 3,
      "heading": 2,
      "meta": 1.5,
      "body": 1
    },
    "authority_weight": 0.01,
    "span_max_lines": 40,
    "result_limit": 10,
    "spans_per_result": 2,
    "match_lines_max": 20,
    "related_max": 5,
    "span_group_coverage": true
  }
}
