{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fdx *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git branch -D *)",
      "Edit(~/.claude/**)",
      "Edit(~/.codex/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git rebase *)"
    ]
  }
}
