/seed/
/temp/
/tests/
/.ouroboros/
# Wiki configuration is reusable; source-dependent runtime data stays local.
/__llm-wiki/*
!/__llm-wiki/.gitignore
!/__llm-wiki/contract.json
!/__llm-wiki/glossary.json

# Publish one writing guide per document role; keep task history local.
/docs/**
!/docs/*/
!/docs/*/doc_gen_guide.md
/PUBLIC_EXPORT.json

# Machine-specific settings; the public export also excludes tracked copies.
/.codex/config.toml
/.agents/skills/worker-agent-control/config.json

# Credentials and local overrides at any depth.
.env
.env.*
!.env.example
*.local.json
*.local.toml
auth.json
credentials.json
*.pem
*.key
id_rsa*
id_ed25519*

# Generated artifacts. Root /tests/ above does not exclude skill tests.
__pycache__/
*.py[cod]
node_modules/
.pytest_cache/
.venv/
.DS_Store
