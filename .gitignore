/seed/
/temp/
/tests/
/.ouroboros/
/specs/
/.serena/
# Wiki configuration is reusable; source-dependent runtime data stays local.
/__llm-wiki/*
!/__llm-wiki/.gitignore
!/__llm-wiki/contract.json
!/__llm-wiki/glossary.json

# Publish one writing guide per document role; keep task history local.
/docs/**
!/docs/*/
!/docs/*/doc_gen_guide.md
/PUBLIC_EXPORT.json

# Campaign skeleton is tracked; instances and the ACTIVE pointer stay local.
/campaigns/*
!/campaigns/README.md
!/campaigns/_template/

# Machine-specific settings; the public export also excludes tracked copies.
/.codex/config.toml
/.codex/hooks.json
/skills/worker-agent-control/config.json

# Project keys and Judge profiles live in envs/; only the examples are tracked.
/envs/*
!/envs/.env.example
!/envs/profile.example.yaml

# Opt-in skills ship inactive; scripts/skill_activation.py lays these links locally.
/.agents/skills/deepeval-pack
/.claude/skills/deepeval-pack
/.agents/skills/skillevaluator
/.claude/skills/skillevaluator

# Improvement targets and their results stay local; only the folder guide is tracked.
/repack_target/*
!/repack_target/README.md

# Credentials and local overrides at any depth.
.env
.env.*
!.env.example
*.local.json
*.local.toml
auth.json
credentials.json
*.pem
*.key
id_rsa*
id_ed25519*

# Generated artifacts. Root /tests/ above does not exclude skill tests.
__pycache__/
*.py[cod]
node_modules/
.pytest_cache/
.venv/
.DS_Store
